{
  "entities": {
    "Fare": {
      "title": "Daily Transit Fare",
      "description": "A single day's transportation fare data",
      "type": "object",
      "properties": {
        "morning": {
          "type": "string",
          "description": "Morning fare amount in GHS"
        },
        "evening": {
          "type": "string",
          "description": "Evening fare amount in GHS"
        },
        "crossedOut": {
          "type": "boolean",
          "description": "Whether the day was marked as no work"
        },
        "note": {
          "type": "string",
          "description": "Short text note for the day"
        },
        "userId": {
          "type": "string",
          "description": "ID of the user who owns the record"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["userId"]
    },
    "WorkTrip": {
      "title": "Work Trip Expenses",
      "description": "A single day's work trip expense records",
      "type": "object",
      "properties": {
        "accommodation": {
          "type": "string",
          "description": "Accommodation expense amount in GHS"
        },
        "food": {
          "type": "string",
          "description": "Food and snack expense amount in GHS"
        },
        "water": {
          "type": "string",
          "description": "Water expense amount in GHS"
        },
        "misc": {
          "type": "string",
          "description": "Miscellaneous expense amount in GHS"
        },
        "note": {
          "type": "string",
          "description": "Short text note for the day"
        },
        "userId": {
          "type": "string",
          "description": "ID of the user who owns the record"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": ["userId"]
    },
    "UserPreferences": {
      "title": "User Preferences",
      "description": "Settings for a user",
      "type": "object",
      "properties": {
        "currency": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "remindersEnabled": {
          "type": "boolean"
        },
        "morningReminderTime": {
          "type": "string"
        },
        "eveningReminderTime": {
          "type": "string"
        },
        "accentColor": {
          "type": "string"
        },
        "recurringMorning": {
          "type": "string"
        },
        "recurringEvening": {
          "type": "string"
        },
        "dailyAllowanceGhs": {
          "type": "string",
          "description": "Daily allowance in GHS for Work Trip savings comparison"
        }
      },
      "required": ["userId", "currency"]
    }
  },
  "firestore": {
    "/users/{userId}/fares/{fareId}": {
      "schema": {
        "$ref": "Fare"
      },
      "description": "Stores daily transit fare records for a user"
    },
    "/users/{userId}/worktrips/{worktripId}": {
      "schema": {
        "$ref": "WorkTrip"
      },
      "description": "Stores daily work trip expense records for a user"
    },
    "/users/{userId}/settings/preferences": {
      "schema": {
        "$ref": "UserPreferences"
      },
      "description": "Stores user-specific settings like default currency"
    }
  }
}
